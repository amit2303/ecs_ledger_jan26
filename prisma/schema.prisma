generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  CLIENT
  VENDOR
}

model Company {
  id        Int      @id @default(autoincrement())
  type      CompanyType
  name      String
  address   String?
  ledgerLink  String?
  director    String?
  contact   String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hasUpdates Boolean @default(false)
  isOnHold   Boolean @default(false)
  
  packages  Package[]
  documents Document[]
}

model Document {
  id        Int      @id @default(autoincrement())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  packageId Int?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  url       String
  name      String
  type      String
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Package {
  id             Int             @id @default(autoincrement())
  companyId      Int
  company        Company         @relation(fields: [companyId], references: [id])
  date           DateTime
  description    String
  charges        Charge[]
  payments       Payment[]
  documents      Document[]
  monthlyCharges MonthlyCharge[]
  createdAt      DateTime        @default(now())
  hasUpdates     Boolean         @default(false)
}

model Charge {
  id              Int            @id @default(autoincrement())
  packageId       Int
  package         Package        @relation(fields: [packageId], references: [id])
  description     String
  amount          Decimal
  date            DateTime       @default(now())
  createdAt       DateTime       @default(now())
  hasUpdates      Boolean        @default(false)
  monthlyChargeId Int?
  monthlyCharge   MonthlyCharge? @relation(fields: [monthlyChargeId], references: [id], onDelete: SetNull)
}

model MonthlyCharge {
  id                 Int       @id @default(autoincrement())
  packageId          Int
  package            Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  description        String
  amount             Decimal
  startDate          DateTime  @default(now())
  dayOfMonth         Int       @default(1)
  isActive           Boolean   @default(true)
  lastGeneratedMonth String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  charges            Charge[]
}

model Payment {
  id          Int      @id @default(autoincrement())
  packageId   Int
  package     Package  @relation(fields: [packageId], references: [id])
  date        DateTime
  description String
  amount      Decimal
  createdAt   DateTime @default(now())
  hasUpdates  Boolean  @default(false)
}

model TransactionMessage {
  id          Int      @id @default(autoincrement())
  rawText     String
  type        String   // PAYMENT | CHARGE
  amount      Float
  companyName String   // Matched company name
  companyId   Int?
  packageId   Int?
  description String?
  status      String   @default("SUCCESS") // SUCCESS | FAILED | AMBIGUOUS
  errorMsg    String?  @db.Text
  paymentId       Int?
  chargeId        Int?
  salaryPaymentId Int?
  employeeId      Int?
  person          String?  // Tagged person: Amit Mishra | Sumit Mishra | Shyam Sunder Mishra | Pankaj Sharma
  isEdited        Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model Employee {
  id          Int      @id @default(autoincrement())
  name        String
  salary      Decimal
  designation String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salaryEntries  SalaryEntry[]
  salaryPayments SalaryPayment[]
}

model SalaryEntry {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       String   // "2026-01" format (YYYY-MM)
  amount      Decimal
  description String?
  createdAt   DateTime @default(now())
}

model SalaryPayment {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount      Decimal
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model HistoricalMonthSummary {
  id            Int      @id @default(autoincrement())
  month         String   @unique // "YYYY-MM" (e.g. "2025-06")
  income        Float
  expense       Float
  net           Float
  ssmIncome     Float    @default(0)
  ssmExpense    Float    @default(0)
  pankajIncome  Float    @default(0)
  pankajExpense Float    @default(0)
  entryCount    Int      @default(0)
  createdAt     DateTime @default(now())
}

